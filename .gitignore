# PlatformIO build output + downloaded libraries
.pio/

# VS Code files PlatformIO regenerates
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Machine-local tool settings
.claude/settings.local.json

# Captured runtime logs (TV_IR_Sending/tools/heap_monitor.ps1)
TV_IR_Sending/tools/*.log
TV_IR_Sending/tools/last_general_log.txt

# Own passwords (see src/Private.example.h) - never commit
TV_IR_Sending/src/Private.h
TV_IR_Receiving/src/Private.h

# Own upload targets (see private.example.ini) - never commit
**/private.ini

# Built firmware files (tools/export_bin.py)
**/firmware_out/
